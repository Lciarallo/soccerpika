    "firebase-functions": "^6.3.2",
    "mercadopago": "^2.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^22.13.4",
    "typescript": "~5.7.3"
  },
  "private": true
