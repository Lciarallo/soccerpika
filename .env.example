# Credenciais do Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE enquanto desenvolve.

# Chave pública: vai para o navegador (tokeniza o cartão). Prefixo VITE_ é obrigatório.
VITE_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Token de acesso: SÓ no servidor. Nunca prefixe com VITE_ e nunca versione o valor real.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Opcional: segredo do webhook, no painel em Webhooks > Configurar notificações.
# Sem ele o endpoint aceita qualquer POST, mas ainda relê o status na API antes de confiar.
MP_WEBHOOK_SECRET=

# ---------------------------------------------------------------- banco ---
# Neon Postgres. Em produção use a connection string COM pooler (-pooler).
DATABASE_URL=postgres://usuario:senha@host/soccerpika?sslmode=require

# Segredo do cookie de sessão. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --------------------------------------------------------------- upload ---
# Vercel Blob, para as fotos que o admin envia pelo painel.
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------ Instagram ---
# Instagram profissional (Business/Creator), via Business Login for Instagram.
# O token e o ID são lidos somente por /api/instagram. Nunca use prefixo VITE_.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Opcional. Atualize quando migrar a versão da Graph API.
INSTAGRAM_GRAPH_API_VERSION=v26.0

# ---------------------------------------- admin inicial (só no db:seed) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
